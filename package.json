{
  "name": "followmyagents",
  "productName": "FollowMyAgents",
  "version": "0.2.3",
  "description": "Widget de bureau qui suit vos sessions Claude Code et répond aux permissions et questions sans ouvrir VS Code.",
  "main": "./out/main/index.js",
  "author": "FollowMyAgents",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/run-electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && node e2e/run.mjs",
    "hooks": "node out/main/cli.js",
    "sandbox": "node scripts/make-sandbox.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac --universal",
    "icons": "node --experimental-strip-types --no-warnings scripts/make-icons.mts",
    "e2e:native": "npm run build && node e2e/native.mjs",
    "e2e:live": "npm run build && node e2e/live.mjs",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "dev.followmyagents.app",
    "productName": "FollowMyAgents",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "FollowMyAgents-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FollowMyAgents-Setup-${version}.${ext}"
    },
    "publish": null
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright": "1.65",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AdrienDIDIER/followmyagents.git"
  }
}
